# Dependencies
node_modules/

# Build artifacts
dist/
*.tsbuildinfo

# VitePress build output
docs/.vitepress/dist
docs/.vitepress/cache

# Local-only Docker Compose override (build from source, machine-specific tweaks)
docker-compose.override.yml
docker-compose.override.yaml

# Environment — never commit real secrets.
# Ignore every .env variant and re-admit the templates, rather than listing each real file: adding a
# new .env.<something> is routine, and remembering to ignore it is exactly what gets forgotten.
.env
.env.*
!.env.example
!.env.dev.example
!.env.test.example

# Claude Code — local/machine-specific settings only
# .claude/settings.json is intentionally NOT ignored (project MCP config)
.claude/settings.local.json

# macOS
.DS_Store

# Logs
*.log
npm-debug.log*

# Test coverage
coverage/

# Editor
.vscode/settings.json
.idea/

# Internal planning docs — kept locally but not tracked
docs/superpowers/
