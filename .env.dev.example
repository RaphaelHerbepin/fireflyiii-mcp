# Local development stack (docker-compose.dev.yml). Copy to .env.dev.
#
#   docker compose -f docker-compose.dev.yml up -d
#   CONTAINER=fireflyiii-dev scripts/ci-create-token.sh http://localhost:8080
#
# The stack is disposable and isolated: named volumes under the `fireflyiii-mcp-dev` Compose project,
# never a bind mount, so `down -v` destroys only this stack's data. Point it at nothing real.

FIREFLY_URL=http://localhost:8080
FIREFLY_TOKEN=paste-the-token-the-script-printed

# Arms the integration suite (src/tests/integration.test.ts).
FIREFLY_INTEGRATION=true

# Arms the tests that need the seeded 2 000-transaction dataset. Leave unset when running against an
# empty instance — those tests assert absolute figures from spec/seed-manifest.json and would fail.
# FIREFLY_SEEDED=true
